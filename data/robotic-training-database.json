          "completion_time_hours": 40,
          "accuracy_percentage": 90,
          "safety_violations": 0
        }
      },
      {
        "module_id": "M02",
        "name": "Material Processing",
        "duration_days": 42,
        "difficulty_level": "Intermediate",
        "objectives": [
          "Material type identification (spectroscopy, weight analysis)",
          "Processing workflows for different materials",
          "Quality control and sorting accuracy",
          "Contamination detection and handling",
          "Waste stream management"
        ],
        "success_criteria": {
          "completion_time_hours": 56,
          "accuracy_percentage": 95,
